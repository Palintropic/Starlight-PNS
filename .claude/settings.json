{
  "permissions": {
    "allow": [
      "Bash(git push origin main)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(git config --local --list)",
      "Bash(dig *)",
      "Bash(brew cat *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/restore_git_identity.sh"
          }
        ]
      }
    ]
  }
}
