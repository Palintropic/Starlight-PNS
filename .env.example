# Starlight-PNS 运行时配置示例
#
#   cp .env.example .env   然后把每一处 replace-with-… 换成真值
#
# 这份文件里**只有变量名和占位符**，一个真凭据都没有，所以它可以进版本库。
# 复制出来的 .env 不进版本库、不进构建上下文、也不进镜像（见 .dockerignore）。
# 容器里没有 .env 文件；配置是由 Compose 注入进程环境的。
#
# PNS_ENV 不在这里：它由镜像和 compose.yaml 固定为 production，好让一次
# 手滑改不动这台服务器的模式。

# ── 必填：管理凭据 ──────────────────────────────────────────────────────
# 用 `openssl rand -hex 32` 生成。至少 32 个字符，不能是占位串——生产模式下
# 缺它、太短、或者还是下面这个示例值，进程都会直接起不来。
PNS_ADMIN_TOKEN=replace-with-openssl-rand-hex-32-output

# ── 必填：模型 provider ─────────────────────────────────────────────────
# 变量名要跟 PNS_API_KEY_NAME 对上。下面这组是 Xiaomi MiMo 按量付费的形状；
# 换 provider 时四行一起改（可选值见 scripts/oobe.py 的 PROVIDERS 表）。
PNS_API_KEY_NAME=MIMO_API_KEY
MIMO_API_KEY=replace-with-your-provider-api-key
API_FORMAT=anthropic
BASE_URL=https://api.xiaomimimo.com/anthropic
PROVIDER=Xiaomi MiMo API

# 生成模型与判分模型可以不同；只写 MODEL 时两者都回退到它。
MODEL=mimo-v2.5-pro
GENERATOR_MODEL=mimo-v2.5-pro
EVALUATOR_MODEL=mimo-v2.5-pro

# ── 可选：会话与网络 ────────────────────────────────────────────────────
# 反向代理提供 HTTPS 时把它设成 true。明文访问下设成 true 会让 Cookie 根本
# 发不出去，所以默认是 false，由操作者显式打开。
PNS_SESSION_COOKIE_SECURE=false
# 操作者登录后的会话有效期（秒）。
PNS_SESSION_TTL_SECONDS=43200
# 宿主上监听的地址与端口。默认只绑回环——TLS 和防火墙属于操作者。
PNS_BIND=127.0.0.1
PNS_PORT=7860

# ── 可选：自主运行节律 ──────────────────────────────────────────────────
# 全部是服务器侧冷配置，浏览器一个字节都传不进来。看不懂的值会让进程响亮
# 失败，不会悄悄回落到默认值。
# PNS_AUTONOMY_TICK_MINUTES=5
# PNS_AUTONOMY_INTERVAL_SECONDS=30
# PNS_AUTONOMY_ACTIVATIONS_PER_RUN=200
# PNS_AUTONOMY_WORLD_ACTION_CAP=100000
# PNS_AUTONOMY_MAX_TOKENS=1024
# PNS_AUTONOMY_TEMPERATURE=0.85

# ── 可选：存档根 ────────────────────────────────────────────────────────
# 默认是 /app/data/worlds，也就是 pns-data 卷里面。改它之前先读部署文档里
# 关于单写者和本地文件系统语义的那一节。
# PNS_WORLD_ROOT=/app/data/worlds
